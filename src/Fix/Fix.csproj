<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Fix</AssemblyName>
    <RootNamespace>TransportSeamRepro.Fix</RootNamespace>
  </PropertyGroup>

  <!--
    The patched client is consumed as a project reference to a checkout of
    rabbitmq/rabbitmq-amqp-dotnet-client with the pull request #180 branch on it, expected next to
    this repository. That is the one extra step this repository needs; see the README.

    To point it somewhere else, set the AmqpClientRepository property on the command line:
    "-p:AmqpClientRepository=/path/to/rabbitmq-amqp-dotnet-client".
  -->
  <PropertyGroup>
    <AmqpClientRepository Condition="'$(AmqpClientRepository)' == ''">$(MSBuildThisFileDirectory)../../../rabbitmq-amqp-dotnet-client</AmqpClientRepository>
    <AmqpClientProject>$(AmqpClientRepository)/RabbitMQ.AMQP.Client/RabbitMQ.AMQP.Client.csproj</AmqpClientProject>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(AmqpClientProject)')">
    <ProjectReference Include="$(AmqpClientProject)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" />
  </ItemGroup>

  <Target Name="RequireAmqpClientRepository" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(AmqpClientProject)')"
           Text="The patched client was not found at '$(AmqpClientProject)'. Clone rabbitmq/rabbitmq-amqp-dotnet-client with the pull request #180 branch checked out next to this repository, or pass -p:AmqpClientRepository=&lt;path&gt;. See the README." />
  </Target>

</Project>
